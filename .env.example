# CyberSentinel Environment Configuration Template
# Duplicate this file as .env in root or backend/ to configure your environment.

# ==========================================
# Frontend Configuration (Next.js)
# ==========================================
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# ==========================================
# Backend Fast API Server
# ==========================================
HOST=127.0.0.1
PORT=8000
DEBUG=True

# ==========================================
# AI Copilot & LangChain Multi-Provider
# (Optional: If omitted, CyberSentinel runs in 100% offline
#  deterministic RAG mode with MITRE ATT&CK vector knowledge)
# ==========================================
OPENAI_API_KEY=
GEMINI_API_KEY=
